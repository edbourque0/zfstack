{
  "name": "zfstack",
  "version": "1.0.0",
  "private": true,
  "description": "ZFStack: manage ZFS pools, disks, servers and services in your home lab",
  "type": "module",
  "scripts": {
    "db": "docker compose up -d db",
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p server/tsconfig.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "tsx --test server/src/*.test.ts web/src/lib/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "lucide-react": "^1.75.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
